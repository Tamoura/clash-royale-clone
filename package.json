{
  "name": "clash-royale-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 3101 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3101 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "vite-node scripts/balance.ts --",
    "relay": "vite-node server/relay.ts",
    "build:relay": "esbuild server/relay.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/relay.mjs --external:ws",
    "relay:prod": "node dist-server/relay.mjs",
    "play": "node scripts/play-lan.mjs",
    "visual-sheet": "node tools/visual-sheet.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "puppeteer-core": "^25.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fontsource/baloo-bhaijaan-2": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@types/three": "^0.184.1",
    "three": "^0.184.0",
    "ws": "^8.21.0"
  }
}
